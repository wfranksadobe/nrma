          "style": "#F7F1EA",
          "blocks": [
            "cards",
            "columns"
          ],
          "defaultContent": []
        },
        {
          "id": "sec3",
          "name": "Home loans band",
          "selector": [
            ".cmp-container--background-secondary-colour"
          ],
          "style": "#D7D667",
          "blocks": [
            "columns"
          ],
          "defaultContent": []
        },
        {
          "id": "sec4",
          "name": "Blog cards + disclaimers",
          "selector": [
            ".cmp-container--background-neutral-colour.cmp-container--has-overlap:nth-of-type(4)",
            ".cmp-container--background-neutral-colour:nth-of-type(4)"
          ],
          "style": "#F7F1EA",
          "blocks": [
            "cards"
          ],
          "defaultContent": []
        }
      ]
