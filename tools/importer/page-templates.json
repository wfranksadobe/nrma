        "https://www.nrma.com.au/"
      ],
      "representativeUrl": "https://www.nrma.com.au/",
      "description": "NRMA homepage — main content sections (nav + footer excluded).",
      "blocks": [
        {
          "name": "hero",
          "instances": [
            ".cmp-container--background-primary-colour"
