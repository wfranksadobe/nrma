            ".cmp-container--background-primary-colour",
            ".cmp-container--background-neutral-colour"
          ]
        },
        {
          "name": "columns",
          "instances": [
            ".cmp-container--background-neutral-colour",
            ".cmp-container--background-secondary-colour"
          ]
        }
      ],
      "urlPattern": "/",
      "sections": [
        {
          "id": "sec1",
          "name": "Hero + promo offers",
          "selector": [
            ".cmp-container--background-primary-colour"
          ],
          "style": "#010C66",
          "blocks": [
            "hero",
            "cards"
          ],
          "defaultContent": []
